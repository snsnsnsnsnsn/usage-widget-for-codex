<Window x:Class="CodexUsageWidget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <!--
        列 = サービス（Codex / Claude）、行 = 利用枠（5h / 週）と更新日。
        行ラベルは左端に1回だけ置き、各列の行の高さはSharedSizeGroupで揃える。
    -->
    <Border Margin="5" Padding="10,8,10,6"
            Background="#F51A1E25" BorderBrush="#26FFFFFF" BorderThickness="1"
            CornerRadius="10">
        <StackPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="Head"/>
                    <RowDefinition Height="Auto" SharedSizeGroup="FiveHour"/>
                    <RowDefinition Height="Auto" SharedSizeGroup="Weekly"/>
                    <RowDefinition Height="Auto" SharedSizeGroup="Model"/>
                    <RowDefinition Height="Auto" SharedSizeGroup="Renewal"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Text="5h" Foreground="{StaticResource TextLabel}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,1.5,0,0"
                           Visibility="{Binding Options.ShowFiveHour, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Grid.Row="2" Text="週" Foreground="{StaticResource TextLabel}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,1.5,0,0"
                           Visibility="{Binding Options.ShowWeekly, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Grid.Row="3" Text="{Binding ModelRowLabel, Mode=OneWay}" Foreground="{StaticResource TextLabel}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,1.5,0,0"
                           Visibility="{Binding ShowModelRow, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Grid.Row="4" Text="更新" Foreground="{StaticResource TextLabel}"
                           FontSize="12" Margin="0,3,0,2" VerticalAlignment="Center"
                           Visibility="{Binding ShowRenewalRow, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="116" Margin="16,0,0,0" Background="Transparent"
                              Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}"
                              ToolTipService.ShowDuration="30000">
                            <!-- ホバー: 枠 / 残り / リセットまで の表と、いつの値かの1行だけ -->
                            <Grid.ToolTip>
                                <ToolTip Padding="10,7">
                                    <StackPanel Grid.IsSharedSizeScope="True">
                                        <ItemsControl ItemsSource="{Binding TooltipRows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TipLabel"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TipRemaining"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Remaining}"
                                                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding UntilReset}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding TooltipFooter}" Opacity="0.65" Margin="0,4,0,0" MaxWidth="260"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TooltipFooter}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="Head"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="FiveHour"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="Weekly"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="Model"/>
                                <RowDefinition Height="Auto" SharedSizeGroup="Renewal"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>

                            <ContentControl Grid.Row="1" Content="{Binding FiveHour}" Focusable="False"
                                            ContentTemplate="{StaticResource LimitCell}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FiveHour.HasWindow}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.ShowFiveHour}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <ContentControl Grid.Row="2" Content="{Binding Weekly}" Focusable="False"
                                            ContentTemplate="{StaticResource LimitCell}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Weekly.HasWindow}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.ShowWeekly}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <!-- 取得できないときは枠2つ分の場所に理由だけを出す -->
                            <TextBlock Grid.Row="1" Grid.RowSpan="2" Text="{Binding StatusMessage, Mode=OneWay}"
                                       Foreground="#D7DDE5" FontSize="12" TextWrapping="Wrap" MaxWidth="110"
                                       HorizontalAlignment="Right" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,6,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- モデル別の週間枠（Fableなど）。枠のない列は空欄 -->
                            <ContentControl Grid.Row="3" Content="{Binding ModelLimit}" Focusable="False"
                                            ContentTemplate="{StaticResource LimitCell}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasModelLimit}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Options.ShowModelLimit}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <TextBlock Grid.Row="4" Text="{Binding RenewalText, Mode=OneWay}"
                                       Foreground="#D7DDE5" FontSize="12" Margin="0,3,0,2"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.ShowRenewalRow,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
